# Copy to .env for docker compose, or export before running locally.
# Every value below is the default; nothing here is required to run the stack.

# --- storage and messaging -------------------------------------------------
DATABASE_URL=postgresql+psycopg2://somno:somno@postgres:5432/somno
REDIS_URL=redis://redis:6379/0
MQTT_URL=mqtt://mosquitto:1883
S3_ENDPOINT=http://minio:9000
S3_BUCKET=somno
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- retention (PRD 10.2) --------------------------------------------------
# Raw waveform is ~1.4 GB per night. Off by default; the derived series is what
# every downstream stage actually reads.
STORE_RAW=false
RAW_RETENTION_DAYS=90

# --- API -------------------------------------------------------------------
API_AUTH_REQUIRED=true
DEV_API_TOKEN=dev-token

# --- PAM safety timing -----------------------------------------------------
# Defaults are the PRD values: 30 s pre-motion notice (PAM-S4) and 20 minutes
# minimum between motions (PAM-S6). Shorten them only for a demo walkthrough.
PAM_NOTIFY_SECONDS=30
PAM_MIN_INTERVAL_S=1200

# --- SIM (docker compose --profile sim) ------------------------------------
SIM_SCENARIO=healthy_adult
SIM_SEED=42
SIM_SPEED=0
SIM_DURATION_MIN=120
SIM_DEVICE=dev-001
SIM_SUBJECT=SUBJ-001
SIM_BED=BED-01
