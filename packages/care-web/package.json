{
  "name": "@somno/care-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CARE - caregiver dashboard, mobile first",
  "scripts": {
    "dev": "vite",
    "lint:terms": "node ../web-shared/scripts/lint-terms.mjs src ../web-shared/src",
    "prebuild": "npm run lint:terms",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.1"
  }
}
